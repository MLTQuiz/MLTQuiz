    "stool_rules": {
        "if": {
            "BA": ["grey", "grey glistening"],
            "next_test": "Oxidase"
        },
        "if": {
            "Oxidase": "Positive",
            "next_test": ["TSI", "MIL", "BA pp", "MAC pp"]
        },
        "if": {
            "MAC": "NLF",
            "next_test": ["TSI", "MIL", "BA pp", "MAC pp"]
        },
        "if": {
            "XLD": ["Red", "Colorless", "Red with black centers", "Colorless with black centers"],
            "next_test": ["TSI", "MIL", "BA pp", "MAC pp"]
        },
        "if": {
            "STEC": "Mauve",
            "next_test": ["TSI", "MIL", "BA pp", "MAC pp"]
        },
        "if": {
            "CIN": "MF",
            "next_test": ["Rhamnose", "TSI", "MIL", "BA pp", "MAC pp"]
        },
        "if": {
            "Karmali": "grey",
            "next_test": "Gram"
        },
        "if": {
            "Gram": "Gram negative bacilli, curved",
            "next_test": ["Oxidase", "Catalase"]
        },
        "if": {
            "MIL": { "Motility": "Motile", "Indole": "Negative", "Lysine Decarboxylase": "Positive" },
            "TSI": "K/A gas H2S",
            "next_test": "Salmonella Latex"
        },
        "if": {
            "MIL": { "Motility": "Non-motile", "Indole": "Negative", "Lysine Decarboxylase": "Negative" },
            "TSI": "K/A",
            "next_test": "Shigella Latex"
        },
        "if": {
            "MIL": {"Motility": "Motile", "Indole": "Positive", "Lysine Decarboxylase": "Positive"},
            "TSI": "A/A gas",
            "next_test": "Shiga Toxin Test"
        },
        "if": {
            "Shiga Toxin Test": { "Positive Control": "Positive", "Stx1": "Positive", "Stx2": "Negative" },
            "next_test": "O157 Latex"
        },
        "if": {
            "Shiga Toxin Test": { "Positive Control": "Positive", "Stx1": "Negative", "Stx2": "Positive" },
            "next_test": "O157 Latex"
        },
        "if": {
            "Shiga Toxin Test": { "Positive Control": "Positive", "Stx1": "Positive", "Stx2": "Positive" },
            "next_test": "O157 Latex"
        }
    }
